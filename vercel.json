{
  "version": 2,
  "rewrites": [
    {
      "source": "/api(.*)",
      "destination": "/api"
    },
    {
      "source": "/graphql(.*)",
      "destination": "/api"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
